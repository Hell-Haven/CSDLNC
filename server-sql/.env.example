# Backend SQL Server rieng. Port mac dinh 8081; MongoDB van o 8080.
HOST=127.0.0.1
PORT=8081
API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=LibrarySqlDemo
# windows: Windows Authentication, khong can SQL_USER/SQL_PASSWORD.
# sql: SQL Server Authentication, can tai khoan SQL do ban tao.
SQL_AUTH=windows
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

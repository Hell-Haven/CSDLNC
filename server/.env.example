# Copy to .env beside this file and fill in your Atlas connection string.
# Server loads .env automatically; PowerShell environment variables override it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/library_db
HOST=127.0.0.1
PORT=8080
API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
# Optional: override Node.js DNS if Atlas SRV lookup fails (Windows DNS unchanged).
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
